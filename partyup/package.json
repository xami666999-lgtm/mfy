{
  "name": "partyup",
  "version": "1.0.0",
  "description": "PartyUp - Unified Game Launcher with Steam, Emulation, Mods, Multiplayer, Cloud Gaming & Hoard-style Save Sync",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:renderer && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:plugins": "tsc -p tsconfig.plugins.json",
    "start": "electron .",
    "start:prod": "electron dist/main/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.yml",
    "package:win": "electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/cheerio": "^0.22.35",
    "@types/jsdom": "^21.1.6",
    "@types/lodash-es": "^4.17.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/semver": "^7.5.5",
    "@types/tar": "^6.1.9",
    "@types/tough-cookie": "^4.0.4",
    "@types/yauzl": "^2.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.2",
    "chart.js": "^4.4.1",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "comlink": "^4.4.0",
    "date-fns": "^2.30.0",
    "electron-debug": "^4.0.0",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.0",
    "electron-settings": "^4.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "electron-window-state": "^5.0.3",
    "embla-carousel-react": "^8.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "form-data": "^4.0.0",
    "framer-motion": "^10.16.5",
    "happy-dom": "^12.10.3",
    "i18next": "^23.7.6",
    "idb": "^8.0.0",
    "jotai": "^2.6.0",
    "jsdom": "^22.1.0",
    "knex": "^3.0.1",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.294.0",
    "msw": "^2.0.11",
    "node-fetch": "^3.3.2",
    "objection": "^3.1.1",
    "playwright": "^1.40.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.20.0",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.10",
    "recharts": "^2.10.3",
    "semver": "^7.5.4",
    "socket.io-client": "^4.7.2",
    "sql.js": "^1.10.3",
    "systeminformation": "^5.21.7",
    "tailwind-merge": "^2.1.0",
    "tailwindcss": "^3.3.5",
    "tar": "^6.2.0",
    "tough-cookie": "^4.1.3",
    "typescript": "^5.3.2",
    "unzipper": "^0.10.14",
    "vaul": "^0.8.9",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^1.0.0",
    "windows-release": "^5.1.1",
    "workbox-window": "^7.0.0",
    "yauzl": "^2.10.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^1.5.0",
    "lint-staged": "^15.1.0",
    "sass-embedded": "^1.105.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.PartyUp.app",
    "productName": "PartyUp",
    "copyright": "Copyright © 2026 PartyUp Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/resources/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "PartyUp Team",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PartyUp",
      "uninstallDisplayName": "PartyUp",
      "license": "LICENSE.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "PartyUp-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xami666999-lgtm",
        "repo": "partyup"
      }
    ],
    "extraResources": [
      {
        "from": "src/resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "build/velo",
        "to": "velo",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "PartyUp Team",
  "license": "MIT",
  "private": true
}
