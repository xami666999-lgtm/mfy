{
  "name": "mfy",
  "version": "1.5.7",
  "description": "MFY - Movies For You",
  "main": "dist-electron/main.js",
  "author": "xami666999-lgtm",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win --x64 --publish never",
    "build:folder": "tsc && vite build && electron-builder --win --x64 --dir",
    "preview": "vite preview",
    "electron:dev": "vite --config vite.config.ts",
    "release": "tsc && vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.12.2",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "shaka-player": "^4.16.3",
    "tailwind-merge": "^3.3.0",
    "webtorrent": "^3.0.21",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.mfy.app",
    "productName": "MFY",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/mfy.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MFY"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xami666999-lgtm",
        "repo": "mfy",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "public/icons/mfy.ico",
        "to": "mfy.ico"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xami666999-lgtm/mfy.git"
  }
}
